    "storykit.whatsnew.feat1.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulates crustal collision, dendritic river incision, precipitation, and Whittaker climate biomes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于板块碰撞、流蚀下切、气流运移与优先流汇流模型，自然发育逼真山脉与河网。"
          }
        }
      }
    },
    "storykit.whatsnew.feat1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tectonics & Fluvial Erosion"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地壳构造与流蚀模拟"
          }
        }
      }
    },
    "storykit.whatsnew.feat2.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procedural street plans, curtain walls, and landmarks across Western, Chinese, Japanese, and Islamic cultures."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城镇规模无级伸缩，依山傍水布局西方、中式、日式与伊斯兰四大文化聚落体系。"
          }
        }
      }
    },
    "storykit.whatsnew.feat2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four Historic Settlement Cultures"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四大历史聚落与文法规划"
          }
        }
      }
    },
    "storykit.whatsnew.feat3.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six paper map styles, real-time diorama lighting, and luminous hologram views with elevation dimensions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理图、水墨、提瓦特、等高线等六款制图样式，支持体积云与全息投影视口。"
          }
        }
      }
    },
    "storykit.whatsnew.feat3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multiple Map Styles & 3D Diorama"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纸质地图与 3D 全息沙盘"
          }
        }
      }
    },
    "storykit.whatsnew.feat4.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift 6 native desktop shell with keyboard shortcuts, file drag & drop, native save panels, and settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "采用 Swift 6 原生外壳，支持 ⌘S/⌘E 原生保存导出、Finder 文件双击关联与离线极速运行。"
          }
        }
      }
    },
    "storykit.whatsnew.feat4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
